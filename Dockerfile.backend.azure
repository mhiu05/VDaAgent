FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

# curl is used by the container health check. Build tools remain only in the
# image layer that installs Python wheels; the application never runs as root.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gcc g++ \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system app \
    && adduser --system --ingroup app app

COPY requirements.azure.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Alembic runs from this same immutable image during the release gate.
COPY --chown=app:app alembic.ini config.yaml ./
COPY --chown=app:app backend ./backend

USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "src.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
