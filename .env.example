# =============================================================================
# P-170 — AI Data Profiling Agent — biến môi trường
#
# Cách dùng:  cp .env.example .env   rồi điền các giá trị BẮT BUỘC bên dưới.
#
# QUY TẮC QUAN TRỌNG:
#   - KHÔNG để chú thích cùng dòng với KEY=  (trình đọc .env sẽ lấy luôn phần
#     chú thích làm giá trị). Chú thích phải nằm ở dòng riêng.
#   - File .env đã nằm trong .gitignore — KHÔNG commit.
#   - Tuỳ chọn không phải secret nằm ở config.yaml, không cần khai lại ở đây.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM PROVIDER  —  [BẮT BUỘC ĐIỀN 1 KEY]
# -----------------------------------------------------------------------------
# Chọn provider (khớp với llm.provider trong config.yaml):
#   openai | openrouter | gemini | groq | together | ollama | custom
LLM_PROVIDER=openai

# Model dùng để diễn giải số liệu & sinh báo cáo.
LLM_MODEL=gpt-4o-mini

# Chỉ cần điền ĐÚNG 1 key tương ứng provider đã chọn ở trên.
# Lấy key tại:
#   openai      -> https://platform.openai.com/api-keys
#   openrouter  -> https://openrouter.ai/keys
#   gemini      -> https://aistudio.google.com/apikey
#   groq        -> https://console.groq.com/keys
#   together    -> https://api.together.xyz/settings/api-keys
#   ollama      -> chạy local, không cần key (điền "ollama" hoặc để trống)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OLLAMA_API_KEY=

# Key dùng chung — nếu điền, key này thắng key theo provider ở trên.
LLM_API_KEY=

# Chỉ điền khi LLM_PROVIDER=custom (endpoint OpenAI-compatible của bạn).
LLM_BASE_URL=


# -----------------------------------------------------------------------------
# 2. DATABASE  —  [TUỲ CHỌN — để trống là dùng SQLite ./data/app.db]
# -----------------------------------------------------------------------------
# Dev: bỏ trống. Production: điền PostgreSQL DSN (ADR-009).
# Ví dụ: postgresql+psycopg://p170:<password>@localhost:5432/p170
DATABASE_URL=

# Database tách biệt chỉ dành cho pytest. Không dùng lại DATABASE_URL của app.
# Ví dụ: postgresql+psycopg://p170_test:<password>@localhost:5432/p170_test
P170_TEST_DATABASE_URL=

# DSN riêng cho LangGraph checkpointer (Known Limitation L2 — HITL chờ nhiều ngày).
# Để trống -> dùng SQLite checkpointer cạnh app.db.
# Ví dụ: postgresql://p170:<password>@localhost:5432/p170
DATABASE_CHECKPOINTER_URL=

# Mật khẩu Postgres dùng bởi docker-compose (service `postgres`).
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# 3. BẢO MẬT API  —  [BẮT BUỘC KHI DEPLOY PUBLIC]
# -----------------------------------------------------------------------------
# Bật kiểm tra token: đặt security.require_api_token: true trong config.yaml
# rồi điền token tự sinh vào đây. Client gửi qua header  Authorization: Bearer <token>
# Sinh token:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=


# -----------------------------------------------------------------------------
# 4. NGUỒN DỮ LIỆU NGOÀI  —  [TUỲ CHỌN — chỉ khi profiling BigQuery]
# -----------------------------------------------------------------------------
# Đường dẫn tới service-account JSON (KHÔNG dán nội dung JSON vào đây).
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
BIGQUERY_DATASET=


# -----------------------------------------------------------------------------
# 5. EMBEDDING CHO QA VECTOR SEARCH  —  [TUỲ CHỌN]
# -----------------------------------------------------------------------------
# Chỉ cần khi retrieval.embedding_provider = openai trong config.yaml.
# Để mặc định (local) thì bỏ trống — dùng sentence-transformers offline.
EMBEDDING_API_KEY=


# -----------------------------------------------------------------------------
# 6. OBSERVABILITY — LANGSMITH  —  [TUỲ CHỌN]
# -----------------------------------------------------------------------------
# Lấy key tại https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p-170-data-profiling


# -----------------------------------------------------------------------------
# 7. AI LOG (bootcamp AI20K)  —  [BẮT BUỘC ĐIỀN nếu còn nộp AI log]
# -----------------------------------------------------------------------------
# Key riêng của MỖI NHÓM, lấy từ link invite của ban tổ chức.
# KHÔNG dùng key của nhóm khác, KHÔNG commit key thật.
AI_LOG_API_KEY=
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_DIR=.ai-log

# -----------------------------------------------------------------------------
# 8. UX COMMAND CENTER - additive rollout (disabled by default)
# -----------------------------------------------------------------------------
UX_COMMAND_CENTER_ENABLED=false
NEXT_PUBLIC_UX_COMMAND_CENTER_ENABLED=false
UX_PREVIEW_TIMEOUT_SECONDS=60
UX_PREVIEW_ROW_BUDGET=50000
