APP_MODE=supabase
# Development only: defaults to true with `next dev`; it is always rejected in production.
DEVELOPMENT_ROLE_BYPASS=

# New runs always use agent-v1. Apply migrations through agent_workspace_runtime
# before enabling admission; the worker continues to drain accepted jobs when
# durable admission is explicitly disabled.
DURABLE_AGENT_EXECUTION_ENABLED=true

# Runtime, Workspace and reconnectable SSE are the default chat experience.
GROK_RUNTIME_ENABLED=true
GROK_WORKSPACE_ENABLED=true
GROK_SSE_ENABLED=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
# Copy this connection string from Supabase Dashboard → Connect. For IPv4-only hosts, select the
# Session Pooler connection string. The application enforces TLS for all PostgreSQL connections.
SUPABASE_DB_URL=

# Gemini is required as the primary provider; OpenAI is the automatic fallback.
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# Runtime-provider settings are used only when GROK_RUNTIME_ENABLED=true.
# The legacy Gemini -> OpenAI narration settings above remain unchanged.
# P0 uses the established Gemini -> OpenAI order. Set either provider to xai
# only when its optional server-only credentials are configured.
AGENT_LLM_PRIMARY_PROVIDER=gemini
AGENT_LLM_FALLBACK_PROVIDER=openai
AGENT_PROVIDER_TIMEOUT_MS=12000
AGENT_TURN_TIMEOUT_MS=45000

XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
XAI_REQUIRE_ZDR=false

# Optional fake clock for scheduler:tick only; omit for real local clock
SCHEDULER_NOW=
