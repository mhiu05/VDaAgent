# VDaAgent root .env (doc 16 "Root `.env`", README "Environment configuration").
#
#   make setup   copies this file to .env and fills every [GENERATED] key with a random value
#   make check   names any [REQUIRED] key that is still empty (never prints values)
#
# Tags: [REQUIRED] must be set · [SECRET] never commit or paste it · [GENERATED] filled by
# make setup, never overwritten · [DEFAULTED] empty = the default shown · [OPTIONAL] feature
# is off when empty.
# An empty value always means "use the default". After editing this file run `make up`
# (or `make restart`); `docker compose restart` keeps the old values.
# Domain warehouse credentials do NOT go here: see domains/<id>/credentials/*.env.

# ---- Model provider -----------------------------------------------------------------------
# [REQUIRED][SECRET] the only model credential, used for every agent call (decision 0008).
# Not required when MODEL_BACKEND=fake. OPENAI_API_KEY / OPENAI_BASE_URL are NOT read.
OPENROUTER_API_KEY=
# [DEFAULTED] https://openrouter.ai/api/v1 — any OpenAI-compatible chat-completions endpoint
# that serves the model ids below (with tool calling)
OPENROUTER_BASE_URL=
# [DEFAULTED] openrouter, or fake (scripted FakeModel, no key needed; tests and demos, doc 17)
MODEL_BACKEND=

# ---- Models (change freely; no source change needed) -------------------------------------
# [DEFAULTED] model for every agent turn: <provider>/<model-id> as the provider names it.
# Must support tool calling. Code default if empty: anthropic/claude-haiku-4.5
AGENT_MODEL=deepseek/deepseek-v4.1-flash
# [DEFAULTED] model for context compaction (summaries); empty = AGENT_MODEL
COMPACTION_MODEL=deepseek/deepseek-v4.1-flash
# [DEFAULTED] typesafe/jev-1.14 — the lead's message router (Decisions API); leave empty
JEV_MODEL=
# [OPTIONAL] context window in tokens; overrides what GET /models reports at boot
MODEL_CONTEXT_TOKENS=

# ---- Authentication -----------------------------------------------------------------------
# [REQUIRED] first admin, created at boot when no admin exists (3-32 chars: a-z 0-9 . _ -)
ADMIN_USERNAME=
# [REQUIRED][SECRET] also the Langfuse login password
ADMIN_PASSWORD=
# [OPTIONAL] demo users alice and bob (both fabrikam); exposed to the browser when DEMO_MODE=true, so use a disposable password
DEMO_PASSWORD=
# [OPTIONAL] explicitly enable quick demo access, including one-click admin demo
DEMO_MODE=false
# [OPTIONAL][SECRET] separate admin-demo account password; required for admin demo seeding
DEMO_ADMIN_PASSWORD=
# [DEFAULTED] 0 for http://localhost; set 1 behind HTTPS (session cookie gets `Secure`)
COOKIE_SECURE=0

# ---- Telegram (optional) ----------------------------------------------------------------
# [OPTIONAL][SECRET] BotFather token; empty = Telegram integration off
TELEGRAM_BOT_TOKEN=
# [OPTIONAL] the bot's @username, without the @
TELEGRAM_BOT_USERNAME=
# (TELEGRAM_WEBHOOK_SECRET is generated by make setup, below)

# ---- Generated by make setup (database, sessions, sandbox, Langfuse) ---------------------
# [GENERATED][SECRET] all of them. POSTGRES_PASSWORD is fixed when the pgdata volume is first
# created: changing it later locks the backend out of the existing database.
POSTGRES_PASSWORD=
SESSION_SECRET=
EXECD_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# ---- Ports and URLs (all published on 127.0.0.1 only) ------------------------------------
# [DEFAULTED] 8080 — the web app (Caddy proxy: SPA + /api on one origin)
PROXY_PORT=
# [DEFAULTED] 8000 — the API published directly, for health checks and scripts
APP_PORT=
# [DEFAULTED] http://localhost:${APP_PORT}; only sent as HTTP-Referer to the model provider
APP_URL=
# [OPTIONAL][SECRET] higher GitHub rate limit for skill installs
GITHUB_TOKEN=
# [DEFAULTED] 300 — seconds uv waits on a package download while agents are provisioned
UV_HTTP_TIMEOUT=

# ---- Frontend -----------------------------------------------------------------------------
# [DEFAULTED] hybrid (real API). mock = demo UI with fake data and no backend. Build-time:
# changing it needs `make up` (rebuilds the frontend image).
VITE_SERVICE_MODE=

# ---- Observability (Langfuse, http://localhost:3100) -------------------------------------
# [DEFAULTED] admin@contoso.local — Langfuse login email (password: ADMIN_PASSWORD)
LANGFUSE_INIT_USER_EMAIL=
# [DEFAULTED] 3100 — Langfuse host port; if you change it, set LANGFUSE_PUBLIC_URL to match
LANGFUSE_PORT=
# [DEFAULTED] http://localhost:3100 (links and NEXTAUTH_URL)
LANGFUSE_PUBLIC_URL=

# ---- Development: PostgreSQL on the host (psql / DBeaver) --------------------------------
# [OPTIONAL] uncomment both to publish the app database on 127.0.0.1 (compose.db-port.yaml)
# COMPOSE_FILE=docker-compose.yml:compose.db-port.yaml
# POSTGRES_HOST_PORT=15432

# ---- Agent runtime tunables (defaults in backend/settings.py) ----------------------------
SOFT_CONTEXT_RATIO=0.6
HARD_CONTEXT_RATIO=0.9
OFFLOAD_CHARS=8000
OFFLOAD_HEAD_CHARS=2000
OFFLOAD_TAIL_CHARS=2000
EXEC_TIMEOUT_S=120
# seconds for `uv add` / `uv sync` in agent folders (PyPI downloads); max 3600
AGENT_PACKAGE_INSTALL_TIMEOUT_S=1200
EXEC_MEM_MB=2048
# per-exec Landlock folder sandbox (doc 11): auto (when the kernel supports it) | required | off
EXEC_FS_ISOLATION=auto
MAX_STEPS_PER_ACTIVATION=50
MODEL_TIMEOUT_S=120
TASK_MAX_S=3600
JEV_K=20
JEV_CONFIDENCE_FLOOR=0.6
MAX_AGENTS_PER_USER=12
