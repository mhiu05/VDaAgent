LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith is server-side only; never expose these as NEXT_PUBLIC_*.
# Keep it false until the project/key are verified; payloads are metadata only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=p170-development
LANGSMITH_DATA_MODE=metadata_only
LANGSMITH_SAMPLING_RATE=1.0
LANGSMITH_FLUSH_TIMEOUT_SECONDS=2.0

# Short-lived staging-only bearer used by the live synthetic evaluator.
# Never commit a real value.
P170_EVAL_BEARER_TOKEN=your_p170_eval_bearer_token_here

APP_ENV=production
STORAGE_PROVIDER=google_drive
GUEST_STORAGE_PROVIDER=supabase
GUEST_MAX_UPLOAD_MB=25
GUEST_RETENTION_HOURS=24
APP_HOST=0.0.0.0
APP_PORT=8000
PROFILING_WORKER_CONCURRENCY=1
PROFILING_WORKER_POLL_SECONDS=1
PROFILING_WORKER_LEASE_SECONDS=300
PROFILING_WORKER_MAX_ATTEMPTS=3
PROFILING_WORKER_SHUTDOWN_GRACE_SECONDS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

VOYAGE_API_KEY=your_voyage_api_key_here

# For Supabase, prefer the transaction pooler endpoint (port 6543) for the API.
# The session pooler (port 5432) has a much smaller per-project client limit.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres?sslmode=require
DATABASE_CHECKPOINTER_URL=postgresql://postgres:password@localhost:5432/postgres

DATABASE_MIGRATION_URL=

AUTH_MODE=supabase
AUTH_ALLOW_GUEST=true

SUPABASE_URL=https://your-project-id.supabase.co
# Derived issuer used by the backend to verify Supabase JWTs. Keep explicit in production.
SUPABASE_AUTH_ISSUER=https://your-project-id.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_STORAGE_BUCKET=p170-dataset
SUPABASE_STORAGE_PREFIX=datasets

GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret_here
# Phải đăng ký chính xác URL này trong Google Cloud Console > OAuth client > Authorized redirect URIs.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=your_google_drive_token_encryption_key_here

API_TOKEN=your_api_token_here
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATASOURCE_ENCRYPTION_KEY=your_fernet_key_here

AI_LOG_API_KEY=your_ai_log_api_key_here
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_DIR=.ai-log

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_ALLOW_SIGNUP=true
NEXT_PUBLIC_AUTH_ALLOW_GUEST=true
AUTH_REQUIRE_EMAIL_CONFIRMED=true
AUTH_ALLOW_SIGNUP=true

UX_COMMAND_CENTER_ENABLED=true
NEXT_PUBLIC_UX_COMMAND_CENTER_ENABLED=true
UX_PREVIEW_TIMEOUT_SECONDS=60
UX_PREVIEW_ROW_BUDGET=50000

# Calendar uses the settings below through the VDaAgent HTTP API; no MCP
# process or frontend secret is required.
# GOOGLE_CALENDAR_CLIENT_ID=Google OAuth Web client ID
# GOOGLE_CALENDAR_CLIENT_SECRET=Google OAuth Web client secret
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=Fernet key generated for this deployment
# GOOGLE_CALENDAR_FRONTEND_URL=http://localhost:3000
# GOOGLE_CALENDAR_DEFAULT_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=Asia/Bangkok
