# =============================================================================
# P-170 — AI Data Profiling Agent — biến môi trường
#
# Cách dùng:  cp .env.example .env   rồi điền các giá trị BẮT BUỘC bên dưới.
#
# QUY TẮC QUAN TRỌNG:
#   - KHÔNG để chú thích cùng dòng với KEY=  (trình đọc .env sẽ lấy luôn phần
#     chú thích làm giá trị). Chú thích phải nằm ở dòng riêng.
#   - File .env đã nằm trong .gitignore — KHÔNG commit.
#   - Tuỳ chọn không phải secret nằm ở config.yaml, không cần khai lại ở đây.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. RUNTIME VÀ CORS
# -----------------------------------------------------------------------------
# Local: development. Azure/production: production.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Danh sách origin frontend, phân tách bằng dấu phẩy. Production phải dùng
# HTTPS domain thực tế của frontend; không dùng * khi có credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 2. LLM PROVIDER  —  [ĐIỀN 1 KEY CHO PROVIDER ĐÃ CHỌN]
# -----------------------------------------------------------------------------
# Chọn provider (khớp với llm.provider trong config.yaml):
#   openai | openrouter | gemini | groq | together | ollama | custom
LLM_PROVIDER=openai

# Model dùng để diễn giải số liệu & sinh báo cáo.
LLM_MODEL=gpt-4o-mini

# Chỉ cần điền ĐÚNG 1 key tương ứng provider đã chọn ở trên.
# Lấy key tại:
#   openai      -> https://platform.openai.com/api-keys
#   openrouter  -> https://openrouter.ai/keys
#   gemini      -> https://aistudio.google.com/apikey
#   groq        -> https://console.groq.com/keys
#   together    -> https://api.together.xyz/settings/api-keys
#   ollama      -> chạy local, không cần key (điền "ollama" hoặc để trống)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OLLAMA_API_KEY=

# Key dùng chung — nếu điền, key này thắng key theo provider ở trên.
LLM_API_KEY=

# Chỉ điền khi LLM_PROVIDER=custom (endpoint OpenAI-compatible của bạn).
LLM_BASE_URL=


# -----------------------------------------------------------------------------
# 3. DATABASE  —  [BẮT BUỘC]
# -----------------------------------------------------------------------------
# PostgreSQL là bắt buộc ở mọi môi trường. Không dùng database development hay
# production cho pytest.
# Ví dụ: postgresql+psycopg://p170:<password>@localhost:5432/p170
DATABASE_URL=

# DSN chỉ dành cho Alembic trong release job. Production nên dùng kết nối trực
# tiếp hoặc session pooler có quyền DDL; để trống thì Alembic dùng DATABASE_URL.
# Không đưa biến này vào frontend hoặc NEXT_PUBLIC_*.
DATABASE_MIGRATION_URL=

# Database tách biệt chỉ dành cho pytest. Không dùng lại DATABASE_URL của app.
# Ví dụ: postgresql+psycopg://p170_test:<password>@localhost:5432/p170_test
P170_TEST_DATABASE_URL=

# DSN riêng cho LangGraph checkpointer (Known Limitation L2 — HITL chờ nhiều ngày).
# Để trống -> dùng DATABASE_URL (chuyển tự động sang PostgreSQL DSN hợp lệ).
# Ví dụ: postgresql://p170:<password>@localhost:5432/p170
DATABASE_CHECKPOINTER_URL=

# -----------------------------------------------------------------------------
# 4. AUTH VÀ SUPABASE  —  [BẮT BUỘC KHI DEPLOY PRODUCTION]
# -----------------------------------------------------------------------------
AUTH_MODE=dual
AUTH_ALLOW_SIGNUP=false
AUTH_ALLOW_GUEST=false
AUTH_REQUIRE_EMAIL_CONFIRMED=true
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=p170-dataset
SUPABASE_STORAGE_PREFIX=datasets

# Tăng timeout/chia chunk nếu upload production đi qua đường truyền chậm.
SUPABASE_STORAGE_TIMEOUT_SECONDS=300
SUPABASE_STORAGE_RESUMABLE_THRESHOLD_MB=6
SUPABASE_STORAGE_CHUNK_MB=6

# -----------------------------------------------------------------------------
# 5. STORAGE VÀ GUEST TRIAL
# -----------------------------------------------------------------------------
# Chọn supabase, google_drive hoặc local. Production thường dùng supabase.
STORAGE_PROVIDER=supabase
GUEST_STORAGE_PROVIDER=supabase
GUEST_MAX_UPLOAD_MB=25
GUEST_RETENTION_HOURS=24

# Chỉ cần khi STORAGE_PROVIDER=google_drive.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 6. BẢO MẬT API
# -----------------------------------------------------------------------------
# Chỉ cần khi security.require_api_token=true trong config.yaml.
# rồi điền token tự sinh vào đây. Client gửi qua header  Authorization: Bearer <token>
# Sinh token:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=


# -----------------------------------------------------------------------------
# 7. RETRIEVAL VÀ NGUỒN DỮ LIỆU NGOÀI
# -----------------------------------------------------------------------------
# Chỉ cần khi retrieval.embedding_provider=voyage trong config.yaml.
VOYAGE_API_KEY=

# Chỉ cần khi retrieval.embedding_provider=openai và không dùng LLM_API_KEY.
EMBEDDING_API_KEY=

# Chỉ cần khi profiling BigQuery.
# Đường dẫn tới service-account JSON (KHÔNG dán nội dung JSON vào đây).
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
BIGQUERY_DATASET=


# -----------------------------------------------------------------------------
# 8. FRONTEND PUBLIC BUILD-TIME VALUES
# -----------------------------------------------------------------------------
# Các biến NEXT_PUBLIC_* được nhúng vào bundle Next.js lúc build. Thay đổi chúng
# yêu cầu build/deploy lại frontend. Chỉ đặt dữ liệu công khai ở đây.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_ALLOW_SIGNUP=false
NEXT_PUBLIC_AUTH_ALLOW_GUEST=false

# Chỉ dùng trong Next.js server (ví dụ route render PDF), không được nhúng vào
# browser bundle. Production trỏ tới backend kèm /api/v1.
INTERNAL_API_URL=http://localhost:8000/api/v1

# Tuỳ chọn; để trống thì route PDF dùng public/fonts/arial.ttf trong image.
PDF_FONT_PATH=

# Command Center cần bật đồng thời ở backend và frontend sau khi đã kiểm thử.
UX_COMMAND_CENTER_ENABLED=false
NEXT_PUBLIC_UX_COMMAND_CENTER_ENABLED=false
UX_PREVIEW_TIMEOUT_SECONDS=60
UX_PREVIEW_ROW_BUDGET=50000

# Trace shadow lưu provenance đã redact; không bật planner/jobs/memory chưa phát hành.
AGENT_TRACE_MODE=shadow


# -----------------------------------------------------------------------------
# 9. OBSERVABILITY — LANGSMITH  —  [TUỲ CHỌN]
# -----------------------------------------------------------------------------
# Lấy key tại https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p-170-data-profiling


# -----------------------------------------------------------------------------
# 10. AI LOG (bootcamp AI20K)  —  [BẮT BUỘC ĐIỀN nếu còn nộp AI log]
# -----------------------------------------------------------------------------
# Key riêng của MỖI NHÓM, lấy từ link invite của ban tổ chức.
# KHÔNG dùng key của nhóm khác, KHÔNG commit key thật.
AI_LOG_API_KEY=
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_DIR=.ai-log
