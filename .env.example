# -----------------------------------------------------------------------------
# 1. LLM PROVIDER  —  [BẮT BUỘC ĐIỀN 1 KEY]
# -----------------------------------------------------------------------------
# Chọn provider (khớp với llm.provider trong config.yaml):
#   openai | openrouter | gemini | groq | together | ollama | custom
LLM_PROVIDER=openai

# Model dùng để diễn giải số liệu & sinh báo cáo.
LLM_MODEL=gpt-4o-mini

# Chỉ cần điền ĐÚNG 1 key tương ứng provider đã chọn ở trên.
# Lấy key tại:
#   openai      -> https://platform.openai.com/api-keys
#   openrouter  -> https://openrouter.ai/keys
#   gemini      -> https://aistudio.google.com/apikey
#   groq        -> https://console.groq.com/keys
#   together    -> https://api.together.xyz/settings/api-keys
#   ollama      -> chạy local, không cần key (điền "ollama" hoặc để trống)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OLLAMA_API_KEY=

# Key dùng chung — nếu điền, key này thắng key theo provider ở trên.
LLM_API_KEY=

# Chỉ điền khi LLM_PROVIDER=custom (endpoint OpenAI-compatible của bạn).
LLM_BASE_URL=


# -----------------------------------------------------------------------------
# 2. DEPLOYMENT  —  [BẮT BUỘC KHI DEPLOY]
# -----------------------------------------------------------------------------
# Production phải dùng PostgreSQL của Supabase. Không dùng Supabase service
# role key ở frontend hoặc trong NEXT_PUBLIC_*.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=https://your-frontend.example.com

# Lấy DATABASE_URL ở Project Overview -> Copy -> Direct connection string
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.zuorlwuxxgmjwvwqrizm.supabase.co:5432/postgres
# Cuối cùng đổi postgresql thành postgresql+psycopg
DATABASE_URL=



# Có thể để trống để dùng DATABASE_URL. Khai báo riêng giúp LangGraph dùng
# plain libpq URL thay vì URL có suffix +psycopg của SQLAlchemy.
DATABASE_CHECKPOINTER_URL=
# Example:
# postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require


# -----------------------------------------------------------------------------
# 3. SUPABASE AUTH + STORAGE  —  [BẮT BUỘC KHI AUTH_MODE=supabase]
# Project URL and publishable key are safe for the browser; secret key is
# backend-only. Never put a secret in NEXT_PUBLIC_*.
AUTH_MODE=supabase
AUTH_ALLOW_SIGNUP=false
# Cho phép dùng thử không cần Supabase account; trial session chỉ dùng dữ liệu guest.
AUTH_ALLOW_GUEST=true
GUEST_STORAGE_PROVIDER=supabase
GUEST_MAX_UPLOAD_MB=25
GUEST_RETENTION_HOURS=24
AUTH_REQUIRE_EMAIL_CONFIRMED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
# Mặc định issuer là ${SUPABASE_URL}/auth/v1. Không cần JWT_SECRET.
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_AUDIENCE=authenticated
AUTH_JWKS_CACHE_TTL_SECONDS=300
# UUID user bootstrap đầu tiên; chỉ dùng trong AUTH_MODE=dual/backfill.
P170_BOOTSTRAP_USER_ID=
# Create a backend-only key called p170-backend in Supabase Settings → API.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# Compatibility one release only; use SUPABASE_SECRET_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=p170-dataset
SUPABASE_STORAGE_PREFIX=datasets
# Seconds allowed for one Storage request; increase for slow links/large files.
SUPABASE_STORAGE_TIMEOUT_SECONDS=300
# Files above this size use Supabase TUS resumable upload.
SUPABASE_STORAGE_RESUMABLE_THRESHOLD_MB=6
SUPABASE_STORAGE_CHUNK_MB=6

# File source backend. Keep supabase for the default; use google_drive after
# completing the Google OAuth setup described in README.md.
STORAGE_PROVIDER=supabase
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_FRONTEND_URL=http://localhost:3000
GOOGLE_DRIVE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_DRIVE_CHUNK_MB=8

# -----------------------------------------------------------------------------
# 3b. FRONTEND PUBLIC CONFIG — [đặt trong chính file .env ở root]
# -----------------------------------------------------------------------------
# Next.js đọc các giá trị này từ root .env qua frontend/next.config.ts.
# SUPABASE_URL và SUPABASE_PUBLISHABLE_KEY ở trên được tự ánh xạ sang frontend;
# không dùng SUPABASE_SECRET_KEY hoặc service-role key ở đây.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_ALLOW_SIGNUP=false
NEXT_PUBLIC_AUTH_ALLOW_GUEST=true



# -----------------------------------------------------------------------------
# 4. LEGACY API TOKEN — CHỈ AUTH_MODE=dual
# -----------------------------------------------------------------------------
# Bật kiểm tra token: đặt security.require_api_token: true trong config.yaml
# rồi điền token tự sinh vào đây. Client gửi qua header  Authorization: Bearer <token>
# Sinh token:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# DATABASE_MIGRATION_URL chỉ dùng cho release job `alembic upgrade head`;
# không đưa DB password vào frontend/CI log.
DATABASE_MIGRATION_URL=


# -----------------------------------------------------------------------------
# 5. NGUỒN DỮ LIỆU NGOÀI  —  [TUỲ CHỌN — chỉ khi profiling BigQuery]
# -----------------------------------------------------------------------------
# Đường dẫn tới service-account JSON (KHÔNG dán nội dung JSON vào đây).
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
BIGQUERY_DATASET=


# -----------------------------------------------------------------------------
# 6. EMBEDDING CHO QA VECTOR SEARCH  —  [TUỲ CHỌN]
# -----------------------------------------------------------------------------
# Chỉ cần khi retrieval.embedding_provider = openai trong config.yaml.
# Retrieval mặc định dùng sentence-transformers offline; không cần API key cho embedding local.
EMBEDDING_API_KEY=
# Chỉ cần khi retrieval.embedding_provider = voyage.
VOYAGE_API_KEY=


# -----------------------------------------------------------------------------
# 7. OBSERVABILITY — LANGSMITH  —  [TUỲ CHỌN]
# -----------------------------------------------------------------------------
# Lấy key tại https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p-170-data-profiling


# 8. AI LOG
AI_LOG_API_KEY=
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_DIR=.ai-log
