{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "capability-result-v1"
    },
    "capability_id": {
      "type": "string",
      "enum": [
        "create_analysis",
        "get_analysis_result",
        "inspect_signal",
        "inspect_decision_intelligence",
        "inspect_visual",
        "inspect_priority_entity",
        "inspect_evidence",
        "get_report_context",
        "inspect_agent_checkpoint"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "pending",
        "failed"
      ]
    },
    "observations": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "claim",
              "metric",
              "decision",
              "status",
              "limitation"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "pending",
              "failed"
            ]
          },
          "canonical_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "display_value": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "support_level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "limited",
                  "exploratory"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "grounding_refs": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "run"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "run_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "queued",
                            "running",
                            "succeeded",
                            "failed",
                            "cancelled"
                          ]
                        }
                      },
                      "required": [
                        "run_id",
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "claim"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "run_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "claim_id": {
                          "type": "string",
                          "maxLength": 200,
                          "pattern": "^[a-z0-9][a-z0-9:._-]*$"
                        }
                      },
                      "required": [
                        "run_id",
                        "artifact_id",
                        "claim_id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "metric"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "run_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "metric_key": {
                          "type": "string",
                          "enum": [
                            "total_inventory",
                            "available_inventory",
                            "available_inventory_rate",
                            "sold_units_7d",
                            "sold_units_30d",
                            "sold_units_90d",
                            "inventory_change_7d",
                            "inventory_change_30d",
                            "inventory_change_90d",
                            "median_inventory_age_days",
                            "p75_inventory_age_days",
                            "slow_moving_units",
                            "slow_moving_rate",
                            "unknown_inventory_age",
                            "unknown_inventory_age_rate",
                            "median_price",
                            "median_price_per_area",
                            "p25_price_per_area",
                            "p75_price_per_area",
                            "price_per_area_iqr",
                            "missing_inventory_age_rate",
                            "missing_price_rate",
                            "missing_area_rate",
                            "records_with_invalid_or_unusable_values",
                            "snapshot_coverage"
                          ]
                        },
                        "evidence_path": {
                          "type": "string",
                          "maxLength": 500,
                          "pattern": "^[A-Za-z0-9_$.[\\]-]+$"
                        }
                      },
                      "required": [
                        "run_id",
                        "artifact_id",
                        "metric_key",
                        "evidence_path"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "artifact"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "run_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "kind": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "required": [
                        "run_id",
                        "artifact_id",
                        "kind"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "evidence"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "run_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "evidence_path": {
                          "type": "string",
                          "maxLength": 500,
                          "pattern": "^[A-Za-z0-9_$.[\\]-]+$"
                        }
                      },
                      "required": [
                        "run_id",
                        "artifact_id",
                        "evidence_path"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "quality"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "run_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "quality_id": {
                          "type": "string",
                          "maxLength": 200,
                          "pattern": "^[a-z0-9][a-z0-9:._-]*$"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "limitation",
                            "quality"
                          ]
                        }
                      },
                      "required": [
                        "run_id",
                        "artifact_id",
                        "quality_id",
                        "kind"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "observation_id",
          "kind",
          "availability",
          "canonical_text",
          "display_value",
          "support_level",
          "grounding_refs"
        ],
        "additionalProperties": false
      }
    },
    "available_workspace_actions": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "open_dashboard"
                  },
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "report_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "run_id",
                  "report_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "open_drilldown"
                  },
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "drilldown_id": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^[a-z0-9][a-z0-9:._-]*$"
                  }
                },
                "required": [
                  "type",
                  "run_id",
                  "drilldown_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "focus_visual"
                  },
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "chart_id": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^[a-z0-9][a-z0-9:._-]*$"
                  }
                },
                "required": [
                  "type",
                  "run_id",
                  "chart_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "focus_priority_entity"
                  },
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "priority_entity_id": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^[a-z0-9][a-z0-9:._-]*$"
                  }
                },
                "required": [
                  "type",
                  "run_id",
                  "priority_entity_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "open_evidence"
                  },
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "artifact_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "evidence_path": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500,
                        "pattern": "^[A-Za-z0-9_$.[\\]-]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "run_id",
                  "artifact_id",
                  "evidence_path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "switch_capability_mode"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "grok",
                      "data",
                      "insight",
                      "compare",
                      "chart",
                      "report"
                    ]
                  }
                },
                "required": [
                  "type",
                  "mode"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "action_id",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "queued_run_ref": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "succeeded",
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "run_id",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "UNSUPPORTED_REQUEST",
            "UNSUPPORTED_CAUSAL_REQUEST",
            "UNSUPPORTED_SCOPE",
            "MISSING_CONTEXT",
            "NO_AUTHORIZED_RESULT",
            "STALE_CONTEXT",
            "PROVIDER_UNAVAILABLE",
            "PROVIDER_TIMEOUT",
            "PROVIDER_OUTPUT_INVALID",
            "RUNTIME_LIMIT_EXCEEDED",
            "CAPABILITY_DENIED",
            "CAPABILITY_UNAVAILABLE",
            "CAPABILITY_OUTPUT_INVALID",
            "GROUNDING_INVALID",
            "TURN_CANCELLED"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "capability_id",
    "status",
    "observations",
    "available_workspace_actions",
    "queued_run_ref",
    "error_code"
  ],
  "additionalProperties": false
}
