{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "analysis-pack-v1"
    },
    "pack_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "org_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "use_case": {
      "type": "string",
      "enum": [
        "slow_moving_inventory"
      ]
    },
    "use_case_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "zone_external_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_external_id",
        "zone_external_id"
      ],
      "additionalProperties": false
    },
    "data_as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "input_refs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "snapshot_refs": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "source_refs": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "limitations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "data_analysis_pack_artifact_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "findings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "category": {
            "type": "string",
            "enum": [
              "concentration",
              "anomaly",
              "current_state",
              "data_quality",
              "trend",
              "segment"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "descriptive",
              "interpretive"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "metric_key": {
            "type": "string",
            "enum": [
              "total_inventory",
              "available_inventory",
              "available_inventory_rate",
              "sold_units_7d",
              "sold_units_30d",
              "sold_units_90d",
              "inventory_change_7d",
              "inventory_change_30d",
              "inventory_change_90d",
              "median_inventory_age_days",
              "p75_inventory_age_days",
              "slow_moving_units",
              "slow_moving_rate",
              "unknown_inventory_age",
              "unknown_inventory_age_rate",
              "median_price",
              "median_price_per_area",
              "p25_price_per_area",
              "p75_price_per_area",
              "price_per_area_iqr",
              "missing_inventory_age_rate",
              "missing_price_rate",
              "missing_area_rate",
              "records_with_invalid_or_unusable_values",
              "snapshot_coverage"
            ]
          },
          "support_level": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "limited"
            ]
          },
          "evidence_refs": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "artifact_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "artifact_id",
                "artifact_key",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "required": [
          "finding_id",
          "candidate_id",
          "category",
          "kind",
          "statement",
          "metric_key",
          "support_level",
          "evidence_refs",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "artifact_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "artifact_id",
          "artifact_key",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "pack_id",
    "run_id",
    "org_id",
    "use_case",
    "use_case_version",
    "scope",
    "data_as_of",
    "semantic_version",
    "input_refs",
    "snapshot_refs",
    "source_refs",
    "limitations",
    "data_analysis_pack_artifact_id",
    "findings",
    "evidence_refs"
  ],
  "additionalProperties": false
}
