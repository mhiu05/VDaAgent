{
  "name": "@vda/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../../.env --import tsx index.ts",
    "start": "node --env-file-if-exists=../../../.env --import tsx index.ts",
    "once": "node --env-file-if-exists=../../../.env --import tsx index.ts --once",
    "scheduler:tick": "node --env-file-if-exists=../../../.env --import tsx index.ts --scheduler-once",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@vda/config": "workspace:*",
    "@vda/db": "workspace:*",
    "@vda/agents": "workspace:*"
  }
}
