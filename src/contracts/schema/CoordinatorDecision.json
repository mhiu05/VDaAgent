{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "coordinator-decision-v1"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "org_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "use_case": {
      "type": "string",
      "enum": [
        "slow_moving_inventory"
      ]
    },
    "use_case_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "zone_external_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_external_id",
        "zone_external_id"
      ],
      "additionalProperties": false
    },
    "requested_data_as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "effective_data_as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "comparison_windows_days": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number",
            "const": 7
          },
          {
            "type": "number",
            "const": 30
          },
          {
            "type": "number",
            "const": 90
          }
        ]
      }
    },
    "entrypoint": {
      "type": "string",
      "enum": [
        "interactive",
        "scheduled"
      ]
    },
    "requested_capability": {
      "type": "string",
      "enum": [
        "analysis",
        "comparison",
        "chart",
        "analyst_follow_up",
        "report_revision"
      ]
    },
    "agent_target": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "coordinator",
            "data",
            "comparison",
            "chart",
            "analyst",
            "insight",
            "report",
            "reviewer"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "new_run",
        "reuse_result",
        "unsupported"
      ]
    },
    "reuse_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unsupported_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "decision_id",
    "org_id",
    "use_case",
    "use_case_version",
    "scope",
    "requested_data_as_of",
    "effective_data_as_of",
    "comparison_windows_days",
    "entrypoint",
    "requested_capability",
    "agent_target",
    "action",
    "reuse_run_id",
    "unsupported_reason"
  ],
  "additionalProperties": false
}
