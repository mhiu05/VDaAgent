{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "org_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "workflow_version": {
      "type": "string",
      "enum": [
        "legacy-v1",
        "agent-v1"
      ]
    },
    "stages": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "coordinator",
              "data",
              "comparison",
              "chart",
              "analyst",
              "insight",
              "report",
              "reviewer"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "agent",
          "status",
          "error_code"
        ],
        "additionalProperties": false
      }
    },
    "draft_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "draft_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "REVISION_REQUIRED"
              ]
            }
          },
          "required": [
            "draft_revision",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "run_id",
    "org_id",
    "workflow_version",
    "stages",
    "draft_revision",
    "review",
    "publication_status"
  ],
  "additionalProperties": false
}
