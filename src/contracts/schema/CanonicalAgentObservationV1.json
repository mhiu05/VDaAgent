{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "claim",
        "metric",
        "decision",
        "status",
        "limitation"
      ]
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "pending",
        "failed"
      ]
    },
    "canonical_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "display_value": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "support_level": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "limited",
            "exploratory"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "grounding_refs": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "run"
              },
              "ref": {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "queued",
                      "running",
                      "succeeded",
                      "failed",
                      "cancelled"
                    ]
                  }
                },
                "required": [
                  "run_id",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "claim"
              },
              "ref": {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "artifact_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "claim_id": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^[a-z0-9][a-z0-9:._-]*$"
                  }
                },
                "required": [
                  "run_id",
                  "artifact_id",
                  "claim_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "metric"
              },
              "ref": {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "artifact_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "metric_key": {
                    "type": "string",
                    "enum": [
                      "total_inventory",
                      "available_inventory",
                      "available_inventory_rate",
                      "sold_units_7d",
                      "sold_units_30d",
                      "sold_units_90d",
                      "inventory_change_7d",
                      "inventory_change_30d",
                      "inventory_change_90d",
                      "median_inventory_age_days",
                      "p75_inventory_age_days",
                      "slow_moving_units",
                      "slow_moving_rate",
                      "unknown_inventory_age",
                      "unknown_inventory_age_rate",
                      "median_price",
                      "median_price_per_area",
                      "p25_price_per_area",
                      "p75_price_per_area",
                      "price_per_area_iqr",
                      "missing_inventory_age_rate",
                      "missing_price_rate",
                      "missing_area_rate",
                      "records_with_invalid_or_unusable_values",
                      "snapshot_coverage"
                    ]
                  },
                  "evidence_path": {
                    "type": "string",
                    "maxLength": 500,
                    "pattern": "^[A-Za-z0-9_$.[\\]-]+$"
                  }
                },
                "required": [
                  "run_id",
                  "artifact_id",
                  "metric_key",
                  "evidence_path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "artifact"
              },
              "ref": {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "artifact_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "run_id",
                  "artifact_id",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "evidence"
              },
              "ref": {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "artifact_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "evidence_path": {
                    "type": "string",
                    "maxLength": 500,
                    "pattern": "^[A-Za-z0-9_$.[\\]-]+$"
                  }
                },
                "required": [
                  "run_id",
                  "artifact_id",
                  "evidence_path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "quality"
              },
              "ref": {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "artifact_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "quality_id": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^[a-z0-9][a-z0-9:._-]*$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "limitation",
                      "quality"
                    ]
                  }
                },
                "required": [
                  "run_id",
                  "artifact_id",
                  "quality_id",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "ref"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "observation_id",
    "kind",
    "availability",
    "canonical_text",
    "display_value",
    "support_level",
    "grounding_refs"
  ],
  "additionalProperties": false
}
