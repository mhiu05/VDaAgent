# AI logs are submitted by the pre-push hook to AI_LOG_SERVER, not committed to
# Git because session.jsonl contains raw prompts. Keep the root structure while
# ignoring runtime logs even if a tool is launched from a nested workspace.
.ai-log/*.jsonl
.ai-log/archive/
**/.ai-log/*.jsonl
**/.ai-log/archive/

# Codex CLI cache
.tmp-openai-docs-cache/

# Temporary and output files
tmp/
output/
report_data.json
docs/plan_pdf.txt
/.agents/scratch/
/temp_api.ts
