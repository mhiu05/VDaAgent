FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . ./

# These are deliberately limited to values safe to embed in a browser bundle.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_AUTH_ALLOW_GUEST
ARG NEXT_PUBLIC_AUTH_ALLOW_SIGNUP
ARG NEXT_PUBLIC_UX_COMMAND_CENTER_ENABLED
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_AUTH_ALLOW_GUEST=$NEXT_PUBLIC_AUTH_ALLOW_GUEST \
    NEXT_PUBLIC_AUTH_ALLOW_SIGNUP=$NEXT_PUBLIC_AUTH_ALLOW_SIGNUP \
    NEXT_PUBLIC_UX_COMMAND_CENTER_ENABLED=$NEXT_PUBLIC_UX_COMMAND_CENTER_ENABLED
RUN pnpm build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=8080

# Next.js standalone contains the production server and only its runtime
# dependencies. public/ includes public/fonts/arial.ttf for server-side PDF.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node
EXPOSE 8080
CMD ["node", "server.js"]
