{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "sh -c '\"$(git rev-parse --show-toplevel)/.cursor/hooks/log_cursor_prompt.sh\"'",
        "commandWindows": "cmd.exe /d /q /c \"for /f \"\"delims=\"\" %R in ('git rev-parse --show-toplevel 2^>nul') do @call \"\"%R\\.cursor\\hooks\\log_cursor_prompt.cmd\"\"\""
      }
    ],
    "stop": [
      {
        "command": "sh -c '\"$(git rev-parse --show-toplevel)/.cursor/hooks/log_cursor_prompt.sh\"'",
        "commandWindows": "cmd.exe /d /q /c \"for /f \"\"delims=\"\" %R in ('git rev-parse --show-toplevel 2^>nul') do @call \"\"%R\\.cursor\\hooks\\log_cursor_prompt.cmd\"\"\""
      }
    ]
  }
}
