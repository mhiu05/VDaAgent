{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "sh -c '\"$(git rev-parse --show-toplevel)/.cursor/hooks/log_cursor_prompt.sh\"'"
      }
    ],
    "stop": [
      {
        "command": "sh -c '\"$(git rev-parse --show-toplevel)/.cursor/hooks/log_cursor_prompt.sh\"'"
      }
    ]
  }
}
