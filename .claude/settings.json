{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/.claude/hooks/log_claude_prompt.sh\"'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/.claude/hooks/log_claude_prompt.sh\"'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/.claude/hooks/log_claude_prompt.sh\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
