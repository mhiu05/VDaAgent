{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/.claude/hooks/log_claude_prompt.sh\"'",
            "commandWindows": "cmd.exe /d /q /c \"for /f \"\"delims=\"\" %R in ('git rev-parse --show-toplevel 2^>nul') do @call \"\"%R\\.claude\\hooks\\log_claude_prompt.cmd\"\"\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/.claude/hooks/log_claude_prompt.sh\"'",
            "commandWindows": "cmd.exe /d /q /c \"for /f \"\"delims=\"\" %R in ('git rev-parse --show-toplevel 2^>nul') do @call \"\"%R\\.claude\\hooks\\log_claude_prompt.cmd\"\"\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/.claude/hooks/log_claude_prompt.sh\"'",
            "commandWindows": "cmd.exe /d /q /c \"for /f \"\"delims=\"\" %R in ('git rev-parse --show-toplevel 2^>nul') do @call \"\"%R\\.claude\\hooks\\log_claude_prompt.cmd\"\"\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
