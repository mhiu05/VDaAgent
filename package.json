{
  "name": "vdaagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @vda/web dev",
    "dev:worker": "pnpm --filter @vda/worker dev",
    "llm:check": "pnpm --filter @vda/worker llm:check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p src/backend/tests/tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config src/backend/tests/vitest.config.ts",
    "test:e2e": "pnpm --filter @vda/backend-tooling test:e2e",
    "test:db": "pnpm --filter @vda/backend-tooling test:db",
    "db:start": "pnpm --filter @vda/backend-tooling db:start",
    "db:reset": "pnpm --filter @vda/backend-tooling db:reset",
    "scheduler:tick": "pnpm --filter @vda/worker scheduler:tick",
    "contracts:export": "tsx src/backend/packages/contracts/src/export.ts",
    "mock-data:validate-source": "tsx src/backend/scripts/mock-data/validate-source.ts",
    "mock-data:import": "tsx src/backend/scripts/mock-data/import-mock-data.ts --import",
    "mock-data:validate-import": "tsx src/backend/scripts/mock-data/validate-import.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.14.5",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
