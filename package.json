{
  "name": "vdaagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @vda/web dev",
    "dev:worker": "pnpm --filter @vda/worker dev",
    "llm:check": "node --env-file-if-exists=.env --import tsx scripts/check-llm.ts",
    "build": "turbo run build",
    "build:backend": "pnpm --filter @vda/worker build",
    "build:web": "pnpm --filter @vda/web build",
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/maintenance/check-format-changed.mjs",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:unit": "vitest run --config tests/vitest.config.ts tests/unit",
    "test:integration": "vitest run --config tests/vitest.config.ts tests/integration",
    "test:api": "vitest run --config tests/vitest.config.ts tests/api",
    "test:workers": "vitest run --config tests/vitest.config.ts tests/workers",
    "test:frontend": "vitest run --config tests/vitest.config.ts tests/frontend",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:durable": "node scripts/run-e2e.mjs --durable",
    "test:db": "node scripts/test-db.mjs",
    "db:start": "supabase start --workdir src/backend",
    "db:reset": "supabase db reset --local --workdir src/backend",
    "scheduler:tick": "pnpm --filter @vda/worker scheduler:tick",
    "contracts:export": "tsx scripts/export-contracts.ts",
    "db:seed:generate": "tsx scripts/seed/generate.ts",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "mock-data:validate-source": "tsx scripts/mock-data/validate-source.ts",
    "mock-data:import": "tsx scripts/mock-data/import.ts --import",
    "mock-data:validate-import": "tsx scripts/mock-data/validate-import.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.2",
    "@vda/agents": "workspace:*",
    "@vda/config": "workspace:*",
    "@vda/contracts": "workspace:*",
    "@vda/db": "workspace:*",
    "@vda/domain": "workspace:*",
    "@vda/semantic": "workspace:*",
    "csv-parse": "7.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.14.5",
    "openai": "7.19.0",
    "postgres": "3.4.9",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
