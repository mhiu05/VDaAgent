{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "APP_MODE",
    "DEVELOPMENT_ROLE_BYPASS",
    "LLM_PRIMARY_PROVIDER",
    "LLM_FALLBACK_PROVIDER",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_DB_URL",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "GROK_RUNTIME_ENABLED",
    "GROK_WORKSPACE_ENABLED",
    "GROK_SSE_ENABLED",
    "AGENT_LLM_PRIMARY_PROVIDER",
    "AGENT_LLM_FALLBACK_PROVIDER",
    "AGENT_PROVIDER_TIMEOUT_MS",
    "AGENT_TURN_TIMEOUT_MS",
    "XAI_API_KEY",
    "XAI_MODEL",
    "XAI_BASE_URL",
    "XAI_REQUIRE_ZDR",
    "SCHEDULER_NOW",
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "@vda/db#build": { "dependsOn": ["^build"], "outputs": [] },
    "@vda/domain#build": { "dependsOn": ["^build"], "outputs": [] },
    "@vda/worker#build": { "dependsOn": ["^build"], "outputs": [] },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
