src/frontend/playwright-report
src/frontend/.env
src/frontend/.env.*
data
tmp
logs
.pytest_cache
.pytest_tmp
.ruff_cache
__pycache__
*.py[cod]
*.log
test-results
playwright-report
tests
docs
worklog
